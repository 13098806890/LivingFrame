{
  "version": 1,
  "report_root": "Artifacts/AgentWorkflow",
  "commit_reports": false,
  "agent_defaults": {
    "model": "gpt-5.6-luna",
    "thinking": "high"
  },
  "collaboration": {
    "default_mode": "pipeline",
    "allowed_modes": [
      "pipeline",
      "parallel-review",
      "debate",
      "manager-tools"
    ]
  },
  "runner": {
    "codex_binary": "codex",
    "model": "gpt-5.6-luna",
    "reasoning_effort": "high",
    "sandbox": "workspace-write",
    "max_parallel_agents": 4,
    "skip_git_repo_check": false
  },
  "required_stages": [
    "developer",
    "code-review",
    "simulator-test",
    "ux-review",
    "agent-evaluation"
  ],
  "governance": {
    "max_rework_cycles_per_stage": 4,
    "stall_checks_before_user_decision": 3,
    "long_stage_check_minutes": 5,
    "max_stage_runtime_minutes": 240,
    "minimum_evaluation_score": 3,
    "require_product_acceptance": true,
    "require_independent_reviewer": true,
    "minimum_discussion_rounds": 1,
    "broad_scope_discussion_rounds": 2
  },
  "simulator_audit_config": ".codex/ui-audit.json",
  "simulator_media_config": ".codex/simulator-media.json",
  "test_knowledge": {
    "enabled": true,
    "root": ".codex/product",
    "features": "features.json",
    "user_flows": "user-flows",
    "test_cases": "test-cases",
    "automation_map": "automation.json",
    "known_issues": "known-issues.json",
    "required_coverage_tiers": [
      "direct",
      "dependency",
      "critical-smoke"
    ]
  },
  "release": {
    "enabled": false,
    "fastlane_directory": "fastlane",
    "release_notes_path": "RELEASE_NOTES.md",
    "metadata_path": "fastlane/metadata/{version}",
    "required_locales": [
      "zh-Hans",
      "en-US"
    ],
    "lanes": {
      "prepare": "prepare_release",
      "metadata-upload": "upload_metadata",
      "binary-upload": "upload_build",
      "submit-for-review": "submit_review",
      "release-to-users": "release"
    },
    "default_actions": [],
    "require_explicit_approval": [
      "metadata-upload",
      "binary-upload",
      "submit-for-review",
      "release-to-users"
    ]
  }
}
