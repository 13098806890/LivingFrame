{
  "version": 1,
  "project_name": "LivingFrame",
  "agent_defaults": {
    "model": "gpt-5.6-luna",
    "thinking": "high"
  },
  "report_root": "Artifacts/AgentWorkflow",
  "commit_reports": false,
  "required_stages": [
    "developer",
    "code-review",
    "simulator-test",
    "ux-review"
  ],
  "simulator_audit_config": ".codex/ui-audit.json",
  "simulator_media_config": ".codex/simulator-media.json",
  "coverage_notes": [
    "测试 Agent 必须使用 ios-simulator-ui-audit Skill。",
    "UI/UX Agent 必须核对测试截图和证据后再接受或拒绝建议。",
    "所有角色报告使用简体中文 HTML，并由编排 Agent 汇总到 index.html。"
  ]
}
